<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The collector run, three times a day. This file is a template: the root placeholder is
	     replaced with the repository's absolute path by deploy/launchd/install.sh, and the copy
	     under ~/Library/LaunchAgents is the one launchd reads. Missed intervals (Mac asleep)
	     run once on wake. -->
	<key>Label</key>
	<string>com.wesmax.insightminer.run</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__ROOT__/deploy/launchd/run.sh</string>
		<string>run</string>
	</array>

	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>6</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>12</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>18</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
	</array>

	<key>RunAtLoad</key>
	<false/>

	<key>WorkingDirectory</key>
	<string>__ROOT__</string>

	<!-- Anything the wrapper prints before its own log is open (a TCC refusal, a missing
	     virtualenv, a bash syntax error) lands here. The job log is data/logs/launchd-run.log. -->
	<key>StandardOutPath</key>
	<string>__ROOT__/data/logs/launchd-run.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__ROOT__/data/logs/launchd-run.stderr.log</string>

	<key>ProcessType</key>
	<string>Background</string>

	<!-- Seconds launchd waits after SIGTERM (bootout, shutdown) before SIGKILL: the run's own
	     wall-clock ceiling (3 h), so a batch in flight can finish and record its status. -->
	<key>ExitTimeOut</key>
	<integer>10800</integer>

	<key>EnvironmentVariables</key>
	<dict>
		<!-- launchd's default PATH is /usr/bin:/bin:/usr/sbin:/sbin. The virtualenv comes first,
		     then Homebrew; run.sh still calls the interpreter by absolute path. -->
		<key>PATH</key>
		<string>__ROOT__/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
	</dict>
</dict>
</plist>
