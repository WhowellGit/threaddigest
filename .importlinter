# Layering contracts from docs/PLAN.md "Module map". Checked by `uv run lint-imports`
# (part of `make check`) and by tests/gates/test_layering.py, which also proves the
# gate can go red.
[importlinter]
root_package = insightminer
include_external_packages = True

[importlinter:contract:layers]
name = Layers: web | cli > services > db | adapters > ports > core
type = layers
# Modules on one line separated by "|" are independent of each other (db never imports
# adapters and vice versa).
layers =
    insightminer.web | insightminer.cli
    insightminer.services
    insightminer.db | insightminer.adapters
    insightminer.ports
    insightminer.core

[importlinter:contract:praw-only-in-the-adapter]
name = praw and prawcore are imported only by insightminer.adapters.reddit_praw
type = forbidden
source_modules =
    insightminer
forbidden_modules =
    praw
    prawcore
ignore_imports =
    insightminer.adapters.reddit_praw -> praw
    insightminer.adapters.reddit_praw -> prawcore
# The adapter module does not exist yet, so its allow-list entries match nothing today.
# "warn" keeps the contract passing on the current tree; the contract still fails the
# moment any other module imports praw.
unmatched_ignore_imports_alerting = warn

[importlinter:contract:web-never-imports-cli]
name = web must not import cli (the CLI mirrors the UI, never the reverse)
type = forbidden
source_modules =
    insightminer.web
forbidden_modules =
    insightminer.cli
