# Layering contracts from docs/PLAN.md "Module map". Checked by `uv run lint-imports`
# (part of `make check`) and by tests/gates/test_layering.py, which also proves the
# gate can go red.
[importlinter]
root_package = threaddigest
include_external_packages = True

[importlinter:contract:layers]
name = Layers: web | cli > services > db | adapters > ports > core
type = layers
# Modules on one line separated by "|" are independent of each other (db never imports
# adapters and vice versa); separated by ":" they share a layer and may import each other,
# with the direction that matters spelled out by its own contract.
#
# `web : cli` is deliberate and one-directional in effect. `cli` is the process's composition
# root, and `threaddigest serve` is the command that constructs the ASGI application and hands
# it to uvicorn, so `cli` imports `web`. The rule the plan states -- "`web` never imports
# `cli`: the CLI mirrors the UI, never the reverse" (D-28) -- is enforced below by the
# `web-never-imports-cli` forbidden contract, which is where a reader looks for it. Written
# with "|", this line also banned the composition root's own import, which no document asks
# for, and `serve` could only have been written by hiding the dependency behind an app string
# uvicorn imports by name -- a dependency the gate cannot see is worse than one it allows.
layers =
    threaddigest.web : threaddigest.cli
    threaddigest.services
    threaddigest.db | threaddigest.adapters
    threaddigest.ports
    threaddigest.core

[importlinter:contract:praw-only-in-the-adapter]
name = praw and prawcore are imported only by threaddigest.adapters.reddit_praw
type = forbidden
source_modules =
    threaddigest
forbidden_modules =
    praw
    prawcore
ignore_imports =
    threaddigest.adapters.reddit_praw -> praw
    threaddigest.adapters.reddit_praw -> prawcore

[importlinter:contract:web-never-imports-cli]
name = web must not import cli (the CLI mirrors the UI, never the reverse)
type = forbidden
source_modules =
    threaddigest.web
forbidden_modules =
    threaddigest.cli
